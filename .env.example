# Copy this file to `.env` and fill in your Firebase project's values.
# Find these in the Firebase console under Project Settings → General →
# "Your apps" → SDK setup and configuration.
#
# NOTE: `.env` is gitignored. Never commit real credentials.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Set to "true" to run against in-memory mock services instead of real
# Firebase. Useful for local UI development without a Firebase project.
# VITE_MOCK_BACKEND=true

# --- Starter sound library (bun run library:upload) --------------------------
# Publishing the factory library to Cloud Storage needs an admin credential.
# These are for the ingestion scripts only; none of them reaches the client
# bundle, and the service account belongs in CI secrets rather than on a
# developer machine.
#
# Bucket to publish to. Falls back to VITE_FIREBASE_STORAGE_BUCKET above.
# FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
#
# Credentials — set exactly one:
#   a path to a service account JSON file, or
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
#   the same JSON inline, which is the form a CI secret takes.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
#
# Point at a running Storage emulator to exercise upload without a real
# project: `firebase emulators:start --only storage`.
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
