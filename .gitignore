# secrets
.env
.firebaserc

# build dirs
node_modules/
.output/
.vinxi/
package-lock.json
# Vinxi transpiles app.config.ts to a fresh timestamped file next to it on
# every dev/build run; these are transient artifacts, never source.
app.config.timestamp_*.js

# test/tool output
test-results/
playwright-report/
blob-report/
# Core-flow walkthrough screenshots. `bun run walkthrough:capture` writes them
# here and `bun run walkthrough:publish` pushes them to the `claude/walkthroughs`
# orphan branch — they are review artefacts and must never enter `main`'s
# history or a feature branch's 400-line diff (see docs/core-flows.md).
walkthroughs/
playwright/.cache/
*-debug.log
.firebase/

# Scratch space at the repo root: screenshots captured for a PR walkthrough,
# intermediate output, one-off scripts. Useful while working and never source —
# a stray `git add -A` had otherwise been one keystroke away from committing a
# megabyte of PNGs.
tmp/

# Throwaway Playwright configs. A sandbox whose pre-installed browser build
# differs from the one @playwright/test pins cannot run the committed configs
# directly, so verifying a browser suite there means writing a short config that
# extends the real one and overrides `executablePath` (see docs/testing.md's
# Browser E2E section). Those are scaffolding for one run and must never be
# committed — ignoring them by pattern is more reliable than remembering to
# delete them, which has already left stray files behind twice.
*.local.config.ts
*.tmp.ts

# editor directories and files
.DS_Store

# misc config
# Shared agent, workflow, and session-hook definitions are checked in, as is the
# settings.json that registers them — a hook only runs for other people if it is
# in the repo. Personal overrides (.claude/settings.local.json) stay ignored.
.claude/*
!.claude/agents/
!.claude/workflows/
!.claude/hooks/
!.claude/settings.json

# big fat blobs
public/samples
