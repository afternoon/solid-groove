# secrets
.env
.firebaserc

# build dirs
node_modules/
.output/
.vinxi/
package-lock.json
# Vinxi transpiles app.config.ts to a fresh timestamped file next to it on
# every dev/build run; these are transient artifacts, never source.
app.config.timestamp_*.js

# test/tool output
test-results/
playwright-report/
blob-report/
playwright/.cache/
*-debug.log
.firebase/

# Throwaway Playwright configs. A sandbox whose pre-installed browser build
# differs from the one @playwright/test pins cannot run the committed configs
# directly, so verifying a browser suite there means writing a short config that
# extends the real one and overrides `executablePath` (see docs/testing.md's
# Browser E2E section). Those are scaffolding for one run and must never be
# committed — ignoring them by pattern is more reliable than remembering to
# delete them, which has already left stray files behind twice.
*.local.config.ts
*.tmp.ts

# editor directories and files
.DS_Store

# misc config
# Shared agent and workflow definitions are checked in; local settings are not.
.claude/*
!.claude/agents/
!.claude/workflows/

# big fat blobs
public/samples
