{
	"hosting": {
		"public": ".output/public",
		"ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
		"rewrites": [
			{
				"source": "**",
				"destination": "/index.html"
			}
		]
	},
	"firestore": {
		"rules": "firestore.rules",
		"indexes": "firestore.indexes.json"
	},
	"storage": {
		"rules": "storage.rules"
	},
	"emulators": {
		"firestore": {
			"port": 8080
		},
		"auth": {
			"port": 9099
		},
		"storage": {
			"port": 9199
		},
		"ui": {
			"enabled": false
		},
		"singleProject": true
	}
}
