rules_version = '2';

// Schema-v1 security rules (PRD 9.9).
//
// Ownership lives on the metadata document only. Child documents under
// `song`, `clips`, and `arrangement` inherit access by resolving their parent,
// so a document can never claim an owner its project does not agree with. Each
// child write costs one document read for that lookup, which is the price of
// not duplicating (and eventually contradicting) ownership on every tier.
//
// The rules also refuse structurally wrong writes: an unknown schema version, a
// missing revision, an unexpected metadata field, or a child document whose
// `projectId` does not match the path it is being written to.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // Anonymous Firebase identities are real identities (PRJ-01): they own
    // projects exactly like a registered user, and upgrading the account keeps
    // the same uid, so nothing here distinguishes them.
    // `get(field, default)` keeps the check total: a document that predates or
    // violates the schema is denied, not an evaluation error that fails a whole
    // query.
    function isMember(data) {
      return signedIn() && (
        request.auth.uid == data.get('ownerId', '') ||
        request.auth.uid in data.get('collaboratorIds', [])
      );
    }

    function memberOfProject(projectId) {
      return exists(/databases/$(database)/documents/projects/$(projectId))
        && isMember(get(/databases/$(database)/documents/projects/$(projectId)).data);
    }

    // `packDependencies` is the derived pack dependency list (LIB-05): one
    // `{ packId, version }` entry per pack the project's assets resolve from.
    // `addedPacks` is the project's pack shelf (LIB-08): the packs the user has
    // added, a superset of the dependency list. The rules check both are lists;
    // the decoder checks their relationship, which the rules cannot see without
    // reading the song document.
    function metadataFields() {
      return ['schemaVersion', 'revision', 'name', 'ownerId', 'collaboratorIds',
              'createdAt', 'modifiedAt', 'template', 'genre', 'packDependencies',
              'addedPacks'];
    }

    function validMetadata(data) {
      return data.keys().hasOnly(metadataFields())
        && data.keys().hasAll(metadataFields())
        && data.schemaVersion == 5
        && data.revision is int && data.revision >= 0
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.ownerId is string && data.ownerId.size() > 0
        && data.collaboratorIds is list
        && data.packDependencies is list
        && data.addedPacks is list
        && data.createdAt is int && data.createdAt >= 0
        && data.modifiedAt is int && data.modifiedAt >= data.createdAt;
    }

    // Every child document names the project it belongs to, so a document
    // copied out of another project is rejected rather than silently adopted.
    function validChild(projectId, data) {
      return data.projectId == projectId
        && data.schemaVersion == 5
        && data.revision is int && data.revision >= 0
        && data.updatedAt is int && data.updatedAt >= 0;
    }

    match /projects/{projectId} {
      // A read of a document that does not exist is allowed and returns nothing:
      // every revision-checked write starts by reading the metadata document,
      // which is missing when the project is being created.
      allow read: if resource == null || isMember(resource.data);

      allow create: if signedIn()
        && request.auth.uid == request.resource.data.ownerId
        && validMetadata(request.resource.data);

      // Ownership cannot be reassigned, and the revision only moves forward.
      allow update: if isMember(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && validMetadata(request.resource.data)
        && request.resource.data.revision >= resource.data.revision;

      allow delete: if signedIn() && request.auth.uid == resource.data.ownerId;

      match /song/{songId} {
        allow read: if memberOfProject(projectId);
        allow create, update: if memberOfProject(projectId)
          && songId == 'current'
          && validChild(projectId, request.resource.data);
        allow delete: if memberOfProject(projectId);
      }

      match /clips/{clipId} {
        allow read: if memberOfProject(projectId);
        allow create, update: if memberOfProject(projectId)
          && request.resource.data.id == clipId
          && validChild(projectId, request.resource.data);
        allow delete: if memberOfProject(projectId);
      }

      match /arrangement/{trackId} {
        allow read: if memberOfProject(projectId);
        allow create, update: if memberOfProject(projectId)
          && request.resource.data.trackId == trackId
          && validChild(projectId, request.resource.data);
        allow delete: if memberOfProject(projectId);
      }
    }

    // Per-user favourite sounds (LIB-011, #691). Favourites belong to the
    // person, so the whole subtree is readable and writable by its owner only.
    // An anonymous identity owns its favourites like a registered one, and an
    // account upgrade keeps the uid, so they follow the person.
    function isUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // One document per sound: a pack-qualified reference and when it was
    // favourited, nothing else (no names, URLs or user-entered text). The
    // document ID is `{packId}~{encoded assetId}`, so it must start with the
    // pack the document names; the decoder checks the rest.
    function validFavourite(favouriteId, data) {
      return data.keys().hasOnly(['schemaVersion', 'packId', 'assetId', 'favouritedAt'])
        && data.keys().hasAll(['schemaVersion', 'packId', 'assetId', 'favouritedAt'])
        && data.schemaVersion == 1
        && data.packId is string && data.packId.matches('^pak_[A-Za-z0-9_-]{21}$')
        && data.assetId is string && data.assetId.size() > 0 && data.assetId.size() <= 200
        && data.favouritedAt is int && data.favouritedAt >= 0
        && favouriteId.matches('^' + data.packId + '~.+$');
    }

    match /users/{userId}/favourites/{favouriteId} {
      allow read, delete: if isUser(userId);
      allow create, update: if isUser(userId)
        && validFavourite(favouriteId, request.resource.data);
    }
  }
}
