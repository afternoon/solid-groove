{
  "name": "solid-groove",
  "devDependencies": {
    "@biomejs/biome": "2.2.5",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.0",
    "@sentry/solidstart": "10.68.0",
    "@sentry/vite-plugin": "5.3.0",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.15.0",
    "@solidjs/start": "^1.1.0",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/user-event": "^14.5.2",
    "@vitest/ui": "3.0.5",
    "fast-check": "^4.9.0",
    "fflate": "^0.8.3",
    "firebase": "^12.3.0",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.24.0",
    "jsdom": "^25.0.1",
    "nanoid": "^6.0.0",
    "node-web-audio-api": "^2.1.0",
    "since-time-ago": "^1.1.1",
    "solid-firebase": "^0.3.0",
    "solid-icons": "^1.1.0",
    "solid-js": "^1.9.3",
    "tone": "^15.1.22",
    "typescript": "^5.6.3",
    "vinxi": "^0.5.7",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.6",
    "vitest": "3.0.5",
    "zod": "^4.4.3"
  },
  "scripts": {
    "samples": "node --env-file-if-exists=.env scripts/generate-samples.mjs && node --env-file-if-exists=.env scripts/starter-library/emitRuntime.mjs",
    "library": "node --env-file-if-exists=.env scripts/starter-library/help.mjs",
    "library:acquire": "node --env-file-if-exists=.env scripts/starter-library/acquire.mjs",
    "library:manage": "node --env-file-if-exists=.env scripts/starter-library/manage.mjs",
    "library:vcsl": "node --env-file-if-exists=.env scripts/starter-library/acquire.mjs --vcsl",
    "library:producer-space": "node --env-file-if-exists=.env scripts/starter-library/acquire.mjs --producer-space",
    "library:freepats-bank": "node --env-file-if-exists=.env scripts/starter-library/acquire.mjs --freepats-bank",
    "library:freesound": "node --env-file-if-exists=.env scripts/starter-library/freesound.mjs",
    "library:candidates": "node --env-file-if-exists=.env scripts/starter-library/acquire/generateCandidates.mjs",
    "library:build": "node --env-file-if-exists=.env scripts/starter-library/build.mjs",
    "library:emit-runtime": "node --env-file-if-exists=.env scripts/starter-library/emitRuntime.mjs",
    "library:emit-fixtures": "node --env-file-if-exists=.env scripts/starter-library/emitBrowserFixtures.mjs",
    "library:audition": "node --env-file-if-exists=.env scripts/starter-library/audition.mjs",
    "library:validate": "node --env-file-if-exists=.env scripts/starter-library/build.mjs --dry-run",
    "library:upload": "node --env-file-if-exists=.env scripts/starter-library/upload.mjs",
    "library:test": "vitest run scripts/starter-library",
    "predev": "bun run samples",
    "dev": "vinxi dev",
    "predev:mock": "bun run samples",
    "dev:mock": "VITE_DEV_BACKEND=mock vinxi dev",
    "predev:emulator": "bun run samples",
    "dev:emulator": "VITE_DEV_BACKEND=emulator vinxi dev",
    "prebuild": "bun run samples",
    "build": "vinxi build",
    "start": "vinxi start",
    "clean": "rm -rf .vinxi .output node_modules/.vinxi node_modules/.vite test-results playwright-report blob-report",
    "firebase:emulator": "firebase emulators:start --only firestore,auth --project demo-solid-groove",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-solid-groove \"vitest run --config vitest.emulator.config.ts\"",
    "pretest:browser": "bun run samples",
    "test:browser": "playwright test",
    "pretest:browser:chromium": "bun run samples",
    "test:browser:chromium": "playwright test --project=chromium",
    "pretest:browser:emulator:chromium": "bun run samples",
    "test:browser:emulator:chromium": "firebase emulators:exec --only firestore,auth --project demo-solid-groove \"playwright test --config=playwright.emulator.config.ts --project=chromium\"",
    "pretest:browser:emulator": "bun run samples",
    "test:browser:emulator": "firebase emulators:exec --only firestore,auth --project demo-solid-groove \"playwright test --config=playwright.emulator.config.ts\"",
    "test:browser:install": "playwright install --with-deps chromium firefox webkit",
    "prewalkthrough:capture": "bun run samples",
    "walkthrough:capture": "CAPTURE_WALKTHROUGH=1 playwright test --project=chromium --workers=1 e2e/flows",
    "prewalkthrough:capture:emulator": "bun run samples",
    "walkthrough:capture:emulator": "CAPTURE_WALKTHROUGH=1 firebase emulators:exec --only firestore,auth --project demo-solid-groove \"playwright test --config=playwright.emulator.config.ts --project=chromium --workers=1 e2e-emulator/flows\"",
    "walkthrough:publish": "node scripts/walkthrough/publish.mjs",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && biome check",
    "check:fix": "biome check --write",
    "verify:bundle": "node --env-file-if-exists=.env scripts/verify-no-secrets-in-bundle.mjs",
    "verify:budget": "node --env-file-if-exists=.env scripts/verify-bundle-budget.mjs",
    "verify:client-config": "node --env-file-if-exists=.env scripts/verify-client-config.mjs",
    "verify:core-flows": "node scripts/check-core-flows.mjs",
    "predeploy": "bun run build && bun run verify:bundle && bun run verify:client-config",
    "deploy": "firebase deploy --only hosting,firestore,storage --non-interactive --project \"$FIREBASE_PROJECT_ID\"",
    "smoke:hosted": "playwright test --config=playwright.smoke.config.ts"
  },
  "type": "module",
  "trustedDependencies": [
    "@firebase/util",
    "@parcel/watcher",
    "protobufjs"
  ]
}
