{
	"name": "solid-groove",
	"devDependencies": {
		"@biomejs/biome": "2.2.5",
		"@firebase/rules-unit-testing": "^5.0.1",
		"@playwright/test": "^1.62.0",
		"@solidjs/meta": "^0.29.4",
		"@solidjs/router": "^0.15.0",
		"@solidjs/start": "^1.1.0",
		"@solidjs/testing-library": "^0.8.10",
		"@testing-library/jest-dom": "^6.6.2",
		"@testing-library/user-event": "^14.5.2",
		"@vitest/ui": "3.0.5",
		"fast-check": "^4.9.0",
		"firebase": "^12.3.0",
		"firebase-tools": "^15.24.0",
		"jsdom": "^25.0.1",
		"nanoid": "^6.0.0",
		"node-web-audio-api": "^2.1.0",
		"since-time-ago": "^1.1.1",
		"solid-firebase": "^0.3.0",
		"solid-icons": "^1.1.0",
		"solid-js": "^1.9.3",
		"tone": "^15.1.22",
		"typescript": "^5.6.3",
		"vinxi": "^0.5.7",
		"vite": "^6.0.0",
		"vite-plugin-solid": "^2.11.6",
		"vitest": "3.0.5",
		"zod": "^4.4.3"
	},
	"scripts": {
		"samples": "node scripts/generate-samples.mjs",
		"predev": "node scripts/generate-samples.mjs",
		"dev": "vinxi dev",
		"prebuild": "node scripts/generate-samples.mjs",
		"build": "vinxi build",
		"start": "vinxi start",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:emulator": "firebase emulators:exec --only firestore --project demo-solid-groove \"vitest run --config vitest.emulator.config.ts\"",
		"pretest:browser": "node scripts/generate-samples.mjs",
		"test:browser": "playwright test",
		"test:browser:install": "playwright install --with-deps chromium firefox webkit",
		"typecheck": "tsc --noEmit",
		"check": "tsc --noEmit && biome check --write",
		"check:ci": "tsc --noEmit && biome check"
	},
	"type": "module",
	"trustedDependencies": [
		"@firebase/util",
		"@parcel/watcher",
		"protobufjs"
	]
}
